# Tag appended to the backend greeting at runtime and baked into the frontend at build time (set BEFORE first deploy)
GREETING_TAG=example-tag

# Example placeholder only; real deployments set this in the ox env editor
DJANGO_SECRET_KEY=insecure-example-key-change-me

# Autowired by the postgres and redis catalog services; leave blank and ox fills them
DATABASE_URL=
REDIS_URL=
